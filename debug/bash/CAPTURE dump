#!/data/data/com.termux/files/usr/bin/bash

# ===== Adjustable Configuration =====
MAX_LINES=5000
MAX_LOG_FILES=5
CAPTURE_DIR="$HOME/terminal-capture"

mkdir -p "$CAPTURE_DIR"

STAMP="$(date +%Y%m%d-%H%M%S)"
LOG="$CAPTURE_DIR/session-$STAMP-$$.log"
RAW="$(mktemp "$CAPTURE_DIR/raw-XXXXXX")"

echo "Recording terminal session."
echo "Readable log: $LOG"
echo "Type 'exit' to finish and save the cleaned log."
echo

printf -v SHELL_COMMAND 'bash --rcfile %q -i' \
    "$CAPTURE_DIR/session.bashrc"

# Record the interactive shell.
script -q -f -c "$SHELL_COMMAND" "$RAW"
SCRIPT_STATUS=$?

# Clean the transcript using Python (already installed in Termux).
python - "$RAW" "$LOG.tmp" "$MAX_LINES" <<'PY'
import re
import sys

source, destination, max_lines = sys.argv[1], sys.argv[2], int(sys.argv[3])

with open(source, "r", encoding="utf-8", errors="replace") as f:
    text = f.read()

# Remove common ANSI/terminal control sequences.
text = re.sub(r'\x1b\[[0-?]*[ -/]*[@-~]', '', text)
text = re.sub(r'\x1b\][^\x07]*(?:\x07|\x1b\\)', '', text)

# Normalize terminal line endings.
text = text.replace("\r\n", "\n").replace("\r", "\n")

lines = text.splitlines(keepends=True)
lines = lines[-max_lines:]

with open(destination, "w", encoding="utf-8") as f:
    f.writelines(lines)
PY

CLEAN_STATUS=$?

if [ "$CLEAN_STATUS" -eq 0 ] && [ -f "$LOG.tmp" ]; then
    mv "$LOG.tmp" "$LOG"
else
    echo "Warning: cleanup failed. Raw transcript retained at: $RAW"
    rm -f "$LOG.tmp"
fi

# Remove the raw transcript only after successful cleanup.
if [ "$CLEAN_STATUS" -eq 0 ]; then
    rm -f "$RAW"
fi

# Keep only the newest configured number of session logs.
ls -1t "$CAPTURE_DIR"/session-*.log 2>/dev/null |
    tail -n "+$((MAX_LOG_FILES + 1))" |
    while IFS= read -r old_log; do
        rm -f -- "$old_log"
    done

echo
echo "Session saved: $LOG"
echo "Maximum lines per log: $MAX_LINES"
echo "Maximum retained session logs: $MAX_LOG_FILES"

exit "$SCRIPT_STATUS"


